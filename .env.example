# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# AI Services
GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key

# Email (Resend)
RESEND_API_KEY=your_resend_api_key
# Verified sender. MUST be an address on a domain verified in Resend, otherwise
# emails to suppliers will NOT be delivered in production.
# Format: "Display Name <address@your-verified-domain.com>"
EMAIL_FROM=Supplai <orders@your-verified-domain.com>

# App URL
# CRITICAL: Set this in production to your actual domain.
# Production (Cloudflare): https://supplai.rlago.com
# Local development: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cron Job Security (used by the manual /api/cron/process-jobs endpoint and the
# Cloudflare Cron Trigger). Generate with: openssl rand -base64 32
CRON_SECRET=your_random_secret_here_min_32_chars
